# --- optional integrations (the app works without any of them) ---

# Claude writes the research profile (summary, interests, methods, competencies, notes for the expert).
# Without it a heuristic profile is used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Scopus Author Retrieval API (https://dev.elsevier.com). H-index is returned only to subscribers,
# i.e. from the ITMO network or with an institutional token.
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=

# OpenAlex free API key (https://openalex.org/settings/api): own daily budget instead of the shared one.
OPENALEX_API_KEY=
# Contact e-mail sent to OpenAlex as a courtesy (optional)
CONTACT_EMAIL=

# Publication window: current year and N previous years (default 4 -> 2022–2026)
PUB_WINDOW_YEARS=4
CACHE_TTL_DAYS=14

# Google Drive folder with sample applications (personal data — keep the link out of git)
EXAMPLES_DRIVE_URL=

# --- deployment ---
# Site login (HTTP Basic). Strongly recommended on a public server.
APP_USERNAME=
APP_PASSWORD=
# Caddy address: ":80" (IP, HTTP), a domain, or "<ip-with-dashes>.sslip.io" for free HTTPS without a domain
SITE_ADDRESS=:80
